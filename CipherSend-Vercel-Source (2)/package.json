{
  "name": "ciphersend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:crypto": "tsx --test tests/*.test.ts",
    "signal:dev": "tsx signaling/src/server.ts",
    "signal:build": "tsc -p signaling/tsconfig.json",
    "signal:start": "node signaling/dist/server.js"
  },
  "dependencies": {
    "autoprefixer": "10.6.2",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "3.4.19",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  }
}
